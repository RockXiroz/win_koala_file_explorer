<Window x:Class="KoalaFileExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:KoalaFileExplorer.Models"
        xmlns:conv="clr-namespace:KoalaFileExplorer.Converters"
        Title="Koala File Explorer" Height="700" Width="1200"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:HexColorToBrushConverter x:Key="HexToBrush"/>
        <conv:FileIconConverter x:Key="FileIcon"/>

        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#E53935"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C62828"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#388E3C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E7D32"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <!-- File list item style -->
        <Style x:Key="FileListItem" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,1" BorderBrush="#F0F0F0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BBDEFB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ═══ TITLE BAR ════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Background="#1565C0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🐨" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Koala File Explorer" FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" VerticalContentAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="White" CornerRadius="4,0,0,4" Padding="8,5">
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Grid.Column="1" Content="🔍 By Name" Command="{Binding SearchByNameCommand}"
                            Style="{StaticResource ToolBtn}" Background="#0D47A1" Margin="0" Padding="10,5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="2" Content="🏷 By Tag" Command="{Binding SearchByTagCommand}"
                            Style="{StaticResource ToolBtn}" Background="#0D47A1" Margin="1,0,0,0" Padding="10,5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="3" Content="✕" Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource ToolBtn}" Background="#424242" Margin="1,0,0,0" Padding="8,5"/>
                </Grid>

                <TextBlock Grid.Column="2" Text="{Binding CurrentPath}" Foreground="#B3E5FC"
                           FontSize="11" VerticalAlignment="Center" MaxWidth="300"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- ═══ STATUS BAR ═══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Background="#EEEEEE" BorderBrush="#BDBDBD"
                BorderThickness="0,1,0,0" Padding="8,3">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#616161"/>
        </Border>

        <!-- ═══ MAIN 3-PANEL LAYOUT ══════════════════════════════════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="150" MaxWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="280" MinWidth="200" MaxWidth="500"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="350"/>
            </Grid.ColumnDefinitions>

            <!-- ── FILE TREE ──────────────────────────────────────────────── -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1" Padding="8,6">
                        <TextBlock Text="📂 File Tree" FontWeight="SemiBold" Foreground="#424242"/>
                    </Border>
                    <TreeView x:Name="FileTreeView" ItemsSource="{Binding RootNodes}"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectedItemChanged="FileTreeView_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type models:DriveNode}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="💾" Margin="0,0,4,0" VerticalAlignment="Center"
                                               Visibility="{Binding HasDummyChild, Converter={StaticResource InvBoolToVis}}"/>
                                    <TextBlock Text="📁" Margin="0,0,4,0" VerticalAlignment="Center"
                                               Visibility="{Binding HasDummyChild, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#E0E0E0" Cursor="SizeWE"/>

            <!-- ── FILE LIST (with thumbnails) ───────────────────────────── -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1" Padding="8,6">
                        <TextBlock Text="📋 File List" FontWeight="SemiBold" Foreground="#424242"/>
                    </Border>

                    <ListView x:Name="FileListView"
                              ItemsSource="{Binding Files}"
                              SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource FileListItem}"
                              SelectionChanged="FileListView_SelectionChanged"
                              MouseDoubleClick="FileListView_MouseDoubleClick"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="68">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail / icon with tag overlay -->
                                    <Grid Grid.Column="0" ClipToBounds="True" Margin="1">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding IsDirectory, Converter={StaticResource FileIcon}}"
                                                   FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource InvBoolToVis}}"/>
                                        <!-- Tag name overlay -->
                                        <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="3,2"
                                                Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding TagSummary}" Foreground="White"
                                                       FontSize="9" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>

                                    <!-- Name + extension -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0">
                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                        <TextBlock Text="{Binding Extension}" FontSize="10" Foreground="#9E9E9E"/>
                                    </StackPanel>

                                    <!-- Size -->
                                    <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                                               FontSize="10" Foreground="#757575"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Margin="0,0,6,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="#E0E0E0" Cursor="SizeWE"/>

            <!-- ── FILE PLAYER + TAGS (right panel, B fills space, C = splitter) ── -->
            <Grid Grid.Column="4" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>           <!-- Header -->
                    <RowDefinition Height="*"/>              <!-- B: Player fills remaining space -->
                    <RowDefinition Height="5"/>              <!-- C: GridSplitter (adjust size) -->
                    <RowDefinition Height="230" MinHeight="120" MaxHeight="450"/>  <!-- Tags -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1" Padding="8,6">
                    <TextBlock Text="▶ File Player &amp; Tags" FontWeight="SemiBold" Foreground="#424242"/>
                </Border>

                <!-- B: Player area (fills all available height) -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- File info -->
                        <RowDefinition Height="*"/>     <!-- Player content -->
                        <RowDefinition Height="Auto"/>  <!-- Controls -->
                    </Grid.RowDefinitions>

                    <!-- File name/path shown when file is selected -->
                    <StackPanel Grid.Row="0" Margin="10,8,10,4"
                                Visibility="{Binding SelectedFile, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding SelectedFile.Name}" FontSize="14"
                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedFile.FullPath}" FontSize="10"
                                   Foreground="#9E9E9E" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Content area -->
                    <Grid Grid.Row="1">

                        <!-- Placeholder: no file selected -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding ShowNoFileSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="🎬" FontSize="56" HorizontalAlignment="Center" Opacity="0.25"/>
                            <TextBlock Text="Select a file to preview" Foreground="#BDBDBD"
                                       HorizontalAlignment="Center" FontSize="13" Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- Media player (B: fills space, no fixed height) -->
                        <Border Background="Black" Cursor="Hand"
                                Visibility="{Binding IsPlayerActive, Converter={StaticResource BoolToVis}}"
                                MouseLeftButtonDown="MediaPreview_Click"
                                ToolTip="Click to open in external player">
                            <MediaElement x:Name="MediaPlayer"
                                          LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                          Stretch="Uniform"
                                          IsHitTestVisible="False"
                                          MediaOpened="MediaPlayer_MediaOpened"
                                          MediaEnded="MediaPlayer_MediaEnded"
                                          MediaFailed="MediaPlayer_MediaFailed"/>
                        </Border>

                        <!-- Non-media file info -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsNonMediaFileSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="📄" FontSize="56" HorizontalAlignment="Center" Opacity="0.35"/>
                            <TextBlock Text="{Binding SelectedFile.Extension}" FontSize="15"
                                       Foreground="#757575" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                            <TextBlock Text="{Binding SelectedFile.SizeDisplay}" FontSize="12"
                                       Foreground="#9E9E9E" HorizontalAlignment="Center"/>
                            <Button Content="📂 Open File" Click="OpenExternalBtn_Click"
                                    Style="{StaticResource GreenBtn}" Margin="0,16,0,0"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Media controls -->
                    <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0"
                            BorderThickness="0,1,0,0" Padding="8,6"
                            Visibility="{Binding IsPlayerActive, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" Margin="0,0,0,4"
                                    IsMoveToPointEnabled="True"
                                    PreviewMouseLeftButtonDown="SeekSlider_MouseDown"
                                    PreviewMouseLeftButtonUp="SeekSlider_MouseUp"
                                    ValueChanged="SeekSlider_ValueChanged"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="⏮" Click="StopBtn_Click" Style="{StaticResource ToolBtn}"
                                        Background="#616161" ToolTip="Stop"/>
                                <Button x:Name="PlayPauseBtn" Content="▶ Play"
                                        Click="PlayPauseBtn_Click" Style="{StaticResource ToolBtn}"/>
                                <Button Content="⏩" Click="FastForwardBtn_Click" Style="{StaticResource ToolBtn}"
                                        Background="#455A64" ToolTip="Fast-forward (Right arrow)"/>
                                <TextBox x:Name="SkipSecondsBox" Text="10" Width="32"
                                         VerticalAlignment="Center" Margin="2,0,0,0"
                                         TextAlignment="Center" FontSize="11"
                                         ToolTip="Fast-forward seconds"/>
                                <TextBlock Text="s" VerticalAlignment="Center" Margin="1,0,6,0"
                                           FontSize="11" Foreground="#757575"/>
                                <TextBlock x:Name="TimeDisplay" Text="0:00 / 0:00"
                                           VerticalAlignment="Center" Margin="2,0,6,0"
                                           FontSize="11" Foreground="#757575"/>
                                <TextBlock Text="🔊" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="1"
                                        Width="70" VerticalAlignment="Center"
                                        ValueChanged="VolumeSlider_ValueChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- C: GridSplitter — drag to adjust player vs tags height -->
                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" Background="#BDBDBD" Cursor="SizeNS"/>

                <!-- Tags section (scrollable) -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Customer Tags" FontWeight="SemiBold" Margin="0,0,0,6"
                                   Foreground="#424242"/>

                        <!-- New tag input -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewTagNameBox" Grid.Column="0" Padding="6,4" FontSize="12"
                                     BorderBrush="#BDBDBD" ToolTip="Enter customer name"
                                     KeyDown="NewTagNameBox_KeyDown"/>
                            <Rectangle Grid.Column="1" x:Name="TagColorRect" Width="28" Height="28"
                                       Margin="4,0" Fill="#2196F3" Cursor="Hand"
                                       MouseLeftButtonDown="TagColorRect_Click" ToolTip="Click to change color"/>
                            <Button Grid.Column="2" Content="+ Add Tag" Style="{StaticResource ToolBtn}"
                                    Click="CreateTagBtn_Click"/>
                        </Grid>

                        <!-- Tag list -->
                        <TextBlock Text="All Tags:" FontSize="11" Foreground="#757575" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding AllTags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="5,3" CornerRadius="4" Background="#F5F5F5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Width="12" Height="12"
                                                       Fill="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                            <!-- Browse all files with this tag -->
                                            <Button Grid.Column="2" Content="📁 Browse"
                                                    Tag="{Binding}" Click="ShowTagFilesBtn_Click"
                                                    Style="{StaticResource GreenBtn}"
                                                    Padding="6,2" Margin="0,0,3,0" FontSize="11"
                                                    ToolTip="Show all files with this tag"/>
                                            <Button Grid.Column="3" Content="＋ Tag File"
                                                    Tag="{Binding}" Click="TagFileBtn_Click"
                                                    Style="{StaticResource ToolBtn}"
                                                    Padding="6,2" Margin="0,0,3,0" FontSize="11"/>
                                            <Button Grid.Column="4" Content="✕"
                                                    Tag="{Binding}" Click="DeleteTagBtn_Click"
                                                    Style="{StaticResource DangerBtn}"
                                                    Padding="6,2" FontSize="11"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Tags on selected file -->
                        <TextBlock Text="Tags on selected file:" FontSize="11" Foreground="#757575"
                                   Margin="0,8,0,4"
                                   Visibility="{Binding SelectedFile, Converter={StaticResource NullToVis}}"/>
                        <ItemsControl ItemsSource="{Binding SelectedFileTags}"
                                      Visibility="{Binding SelectedFile, Converter={StaticResource NullToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                            CornerRadius="10" Padding="8,3" Margin="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="White"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <Button Content=" ✕" Foreground="White" Background="Transparent"
                                                    BorderThickness="0" Padding="2,0" FontSize="10"
                                                    Tag="{Binding}" Click="RemoveTagBtn_Click" Cursor="Hand"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

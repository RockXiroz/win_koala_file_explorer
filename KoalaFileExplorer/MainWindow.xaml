<Window x:Class="KoalaFileExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:KoalaFileExplorer.Models"
        xmlns:conv="clr-namespace:KoalaFileExplorer.Converters"
        Title="Koala File Explorer" Height="700" Width="1200"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:HexColorToBrushConverter x:Key="HexToBrush"/>
        <conv:FileIconConverter x:Key="FileIcon"/>

        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#E53935"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C62828"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#388E3C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E7D32"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SortBtn" TargetType="Button">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <!-- File list item style -->
        <Style x:Key="FileListItem" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,1" BorderBrush="#F0F0F0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BBDEFB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ═══ TITLE BAR ════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Background="#1565C0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🐨" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Koala File Explorer" FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" VerticalContentAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="White" CornerRadius="4,0,0,4" Padding="8,5">
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Grid.Column="1" Content="🔍 By Name" Command="{Binding SearchByNameCommand}"
                            Style="{StaticResource ToolBtn}" Background="#0D47A1" Margin="0" Padding="10,5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="2" Content="🏷 By Tag" Command="{Binding SearchByTagCommand}"
                            Style="{StaticResource ToolBtn}" Background="#0D47A1" Margin="1,0,0,0" Padding="10,5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="3" Content="✕" Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource ToolBtn}" Background="#424242" Margin="1,0,0,0" Padding="8,5"/>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentPath}" Foreground="#B3E5FC"
                               FontSize="11" VerticalAlignment="Center" MaxWidth="220"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Content="⌨ Keys" Click="ShowShortcutsBtn_Click"
                            Style="{StaticResource ToolBtn}" Background="#0D47A1"
                            Margin="8,0,0,0" Padding="8,4" FontSize="11"
                            ToolTip="Show / customize keyboard shortcuts"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ STATUS BAR ═══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Background="#EEEEEE" BorderBrush="#BDBDBD"
                BorderThickness="0,1,0,0" Padding="8,3">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#616161"/>
        </Border>

        <!-- ═══ MAIN 3-PANEL LAYOUT ══════════════════════════════════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="150" MaxWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="280" MinWidth="200" MaxWidth="500"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="350"/>
            </Grid.ColumnDefinitions>

            <!-- ── FILE TREE + TAGS (A) ──────────────────────────────────── -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="230" MinHeight="80" MaxHeight="420"/>
                    </Grid.RowDefinitions>

                    <!-- File tree -->
                    <DockPanel Grid.Row="0">
                        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,1" Padding="8,6">
                            <TextBlock Text="📂 File Tree" FontWeight="SemiBold" Foreground="#424242"/>
                        </Border>
                        <TreeView x:Name="FileTreeView" ItemsSource="{Binding RootNodes}"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectedItemChanged="FileTreeView_SelectedItemChanged">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type models:DriveNode}"
                                                          ItemsSource="{Binding Children}">
                                    <StackPanel Margin="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾" Margin="0,0,4,0" VerticalAlignment="Center"
                                                       Visibility="{Binding HasDummyChild, Converter={StaticResource InvBoolToVis}}"/>
                                            <TextBlock Text="📁" Margin="0,0,4,0" VerticalAlignment="Center"
                                                       Visibility="{Binding HasDummyChild, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding HasCapacity, Converter={StaticResource BoolToVis}}"
                                                    Margin="0,2,0,0">
                                            <ProgressBar Value="{Binding UsedPercent}" Maximum="100"
                                                         Height="5" Foreground="#1976D2"/>
                                            <TextBlock Text="{Binding CapacityText}" FontSize="9"
                                                       Foreground="#757575" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                                  Background="#BDBDBD" Cursor="SizeNS"/>

                    <!-- ── TAGS PANE (A) ───────────────────────────────────── -->
                    <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#EEEEEE" BorderBrush="#E0E0E0"
                                    BorderThickness="0,0,0,1" Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🏷 Tags" FontWeight="SemiBold" Foreground="#424242" FontSize="12"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Pill:" FontSize="9" Foreground="#757575"
                                                   VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <Slider Minimum="7" Maximum="16"
                                                Value="{Binding TagPillFontSize, Mode=TwoWay}"
                                                Width="55" VerticalAlignment="Center"
                                                SmallChange="1" LargeChange="1"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                ToolTip="Tag pill text size"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="6">
                                    <!-- New tag row -->
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewTagNameBox" Grid.Column="0" Padding="4,3" FontSize="11"
                                                 BorderBrush="#BDBDBD" ToolTip="Tag name"
                                                 KeyDown="NewTagNameBox_KeyDown"/>
                                        <Rectangle Grid.Column="1" x:Name="TagColorRect" Width="22" Height="22"
                                                   Margin="3,0" Fill="#2196F3" Cursor="Hand"
                                                   MouseLeftButtonDown="TagColorRect_Click" ToolTip="Background color"/>
                                        <Rectangle Grid.Column="2" x:Name="TagTextColorRect" Width="22" Height="22"
                                                   Margin="0,0,3,0" Fill="#FFFFFF" Stroke="#BDBDBD" StrokeThickness="1"
                                                   Cursor="Hand" MouseLeftButtonDown="TagTextColorRect_Click"
                                                   ToolTip="Text color"/>
                                        <Button Grid.Column="3" Content="+" Style="{StaticResource ToolBtn}"
                                                Padding="7,3" FontSize="13"
                                                Click="CreateTagBtn_Click" ToolTip="Create tag"/>
                                    </Grid>

                                    <!-- All tags list -->
                                    <ItemsControl ItemsSource="{Binding AllTags}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,2" Padding="4,3" CornerRadius="3" Background="#F0F0F0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Background color swatch — click to cycle -->
                                                        <Rectangle Grid.Column="0" Width="13" Height="13"
                                                                   Fill="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                                   Margin="0,0,2,0" VerticalAlignment="Center"
                                                                   Cursor="Hand" Tag="{Binding}"
                                                                   MouseLeftButtonDown="TagBgColorSwatch_Click"
                                                                   ToolTip="Click to change background color"/>
                                                        <!-- Text color swatch — click to cycle -->
                                                        <Rectangle Grid.Column="1" Width="13" Height="13"
                                                                   Fill="{Binding TextColor, Converter={StaticResource HexToBrush}}"
                                                                   Stroke="#BDBDBD" StrokeThickness="1"
                                                                   Margin="0,0,5,0" VerticalAlignment="Center"
                                                                   Cursor="Hand" Tag="{Binding}"
                                                                   MouseLeftButtonDown="TagTextColorSwatch_Click"
                                                                   ToolTip="Click to change text color"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Name}"
                                                                   FontSize="11" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="3" Content="📁"
                                                                Tag="{Binding}" Click="ShowTagFilesBtn_Click"
                                                                Style="{StaticResource GreenBtn}"
                                                                Padding="3,2" Margin="0,0,2,0" FontSize="10"
                                                                ToolTip="Browse files with tag"/>
                                                        <Button Grid.Column="4" Content="+"
                                                                Tag="{Binding}" Click="TagFileBtn_Click"
                                                                Style="{StaticResource ToolBtn}"
                                                                Padding="3,2" Margin="0,0,2,0" FontSize="12"
                                                                ToolTip="Tag selected file"/>
                                                        <Button Grid.Column="5" Content="✕"
                                                                Tag="{Binding}" Click="DeleteTagBtn_Click"
                                                                Style="{StaticResource DangerBtn}"
                                                                Padding="4,2" FontSize="10"
                                                                ToolTip="Delete tag"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Tags on selected file -->
                                    <TextBlock Text="Selected file tags:" FontSize="10" Foreground="#757575"
                                               Margin="0,6,0,3"
                                               Visibility="{Binding SelectedFile, Converter={StaticResource NullToVis}}"/>
                                    <ItemsControl ItemsSource="{Binding SelectedFileTags}"
                                                  Visibility="{Binding SelectedFile, Converter={StaticResource NullToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                        CornerRadius="8" Padding="6,2" Margin="1,1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Foreground="White"
                                                                   FontSize="10" VerticalAlignment="Center"/>
                                                        <Button Content=" ✕" Foreground="White" Background="Transparent"
                                                                BorderThickness="0" Padding="1,0" FontSize="9"
                                                                Tag="{Binding}" Click="RemoveTagBtn_Click" Cursor="Hand"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#E0E0E0" Cursor="SizeWE"/>

            <!-- ── FILE LIST (with thumbnails) ───────────────────────────── -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1" Padding="6,4">
                        <Grid>
                            <TextBlock Text="📋 File List" FontWeight="SemiBold" Foreground="#424242"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding NameSortHeader}" Click="SortName_Click" Style="{StaticResource SortBtn}"/>
                                <Button Content="{Binding DateSortHeader}" Click="SortDate_Click" Style="{StaticResource SortBtn}"/>
                                <Button Content="{Binding SizeSortHeader}" Click="SortSize_Click" Style="{StaticResource SortBtn}"/>
                                <Button Content="{Binding TypeSortHeader}" Click="SortType_Click" Style="{StaticResource SortBtn}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListView x:Name="FileListView"
                              ItemsSource="{Binding Files}"
                              SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                              SelectionMode="Extended"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource FileListItem}"
                              SelectionChanged="FileListView_SelectionChanged"
                              MouseDoubleClick="FileListView_MouseDoubleClick"
                              PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                              PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                              MouseMove="FileList_MouseMove"
                              AllowDrop="False"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="68">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail / icon with tag overlay -->
                                    <Grid Grid.Column="0" ClipToBounds="True" Margin="1">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding IsDirectory, Converter={StaticResource FileIcon}}"
                                                   FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource InvBoolToVis}}"/>
                                        <!-- Tag overlay: colored pills -->
                                        <Border VerticalAlignment="Bottom" Background="#AA000000" Padding="2,2"
                                                Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding Tags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                                CornerRadius="3" Padding="3,1" Margin="1,1">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="{Binding TextColor, Converter={StaticResource HexToBrush}}"
                                                                       FontSize="{Binding DataContext.TagPillFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Grid>

                                    <!-- Name + extension -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0">
                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                        <TextBlock Text="{Binding Extension}" FontSize="10" Foreground="#9E9E9E"/>
                                    </StackPanel>

                                    <!-- Size -->
                                    <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                                               FontSize="10" Foreground="#757575"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Margin="0,0,6,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="#E0E0E0" Cursor="SizeWE"/>

            <!-- ── FILE PLAYER + FIND PANE ──────────────────────────────────── -->
            <Grid Grid.Column="4" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="FindSplitterRow" Height="0"/>
                    <RowDefinition x:Name="FindPaneRow" Height="0" MinHeight="0"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1" Padding="8,6">
                    <TextBlock Text="▶ File Player" FontWeight="SemiBold" Foreground="#424242"/>
                </Border>

                <!-- B: Player area (fills all available height) -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- File info -->
                        <RowDefinition Height="*"/>     <!-- Player content -->
                        <RowDefinition Height="Auto"/>  <!-- Controls -->
                    </Grid.RowDefinitions>

                    <!-- File name/path shown when file is selected -->
                    <StackPanel Grid.Row="0" Margin="10,8,10,4"
                                Visibility="{Binding SelectedFile, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding SelectedFile.Name}" FontSize="14"
                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedFile.FullPath}" FontSize="10"
                                   Foreground="#9E9E9E" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Content area -->
                    <Grid Grid.Row="1">

                        <!-- Placeholder: no file selected -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding ShowNoFileSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="🎬" FontSize="56" HorizontalAlignment="Center" Opacity="0.25"/>
                            <TextBlock Text="Select a file to preview" Foreground="#BDBDBD"
                                       HorizontalAlignment="Center" FontSize="13" Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- Media player (B: fills space, no fixed height) -->
                        <Border Background="Black" Cursor="Hand"
                                Visibility="{Binding IsPlayerActive, Converter={StaticResource BoolToVis}}"
                                MouseLeftButtonDown="MediaPreview_Click"
                                ToolTip="Click to open in external player">
                            <MediaElement x:Name="MediaPlayer"
                                          LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                          Stretch="Uniform"
                                          IsHitTestVisible="False"
                                          MediaOpened="MediaPlayer_MediaOpened"
                                          MediaEnded="MediaPlayer_MediaEnded"
                                          MediaFailed="MediaPlayer_MediaFailed"/>
                        </Border>

                        <!-- Non-media file info -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsNonMediaFileSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="📄" FontSize="56" HorizontalAlignment="Center" Opacity="0.35"/>
                            <TextBlock Text="{Binding SelectedFile.Extension}" FontSize="15"
                                       Foreground="#757575" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                            <TextBlock Text="{Binding SelectedFile.SizeDisplay}" FontSize="12"
                                       Foreground="#9E9E9E" HorizontalAlignment="Center"/>
                            <Button Content="📂 Open File" Click="OpenExternalBtn_Click"
                                    Style="{StaticResource GreenBtn}" Margin="0,16,0,0"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Media controls -->
                    <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0"
                            BorderThickness="0,1,0,0" Padding="8,6"
                            Visibility="{Binding IsPlayerActive, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" Margin="0,0,0,4"
                                    IsMoveToPointEnabled="True"
                                    PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseDown"
                                    PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseUp"
                                    Thumb.DragStarted="SeekSlider_DragStarted"
                                    Thumb.DragCompleted="SeekSlider_DragCompleted"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="⏮" Click="StopBtn_Click" Style="{StaticResource ToolBtn}"
                                        Background="#616161" ToolTip="Stop"/>
                                <Button x:Name="PlayPauseBtn" Content="▶ Play"
                                        Click="PlayPauseBtn_Click" Style="{StaticResource ToolBtn}"/>
                                <Button Content="⏩" Click="FastForwardBtn_Click" Style="{StaticResource ToolBtn}"
                                        Background="#455A64" ToolTip="Fast-forward (Right arrow)"/>
                                <TextBox x:Name="SkipSecondsBox" Text="10" Width="32"
                                         VerticalAlignment="Center" Margin="2,0,0,0"
                                         TextAlignment="Center" FontSize="11"
                                         ToolTip="Fast-forward seconds"/>
                                <TextBlock Text="s" VerticalAlignment="Center" Margin="1,0,6,0"
                                           FontSize="11" Foreground="#757575"/>
                                <TextBlock x:Name="TimeDisplay" Text="0:00 / 0:00"
                                           VerticalAlignment="Center" Margin="2,0,6,0"
                                           FontSize="11" Foreground="#757575"/>
                                <TextBlock Text="🔊" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="1"
                                        Width="70" VerticalAlignment="Center"
                                        ValueChanged="VolumeSlider_ValueChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── FIND PANE SPLITTER (row 2 — resizes player vs find pane) ── -->
                <GridSplitter x:Name="FindPaneSplitter" Grid.Row="2" Height="5"
                              HorizontalAlignment="Stretch" Background="#BDBDBD" Cursor="SizeNS"
                              Visibility="Collapsed"/>

                <!-- ── FIND PANE CONTENT (row 3) ─────────────────────────────── -->
                <Border x:Name="FindPaneContent" Grid.Row="3" Background="#FAFAFA"
                        BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#EEEEEE" BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,1" Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍 Find Files  (Ctrl+F)" FontWeight="SemiBold"
                                           FontSize="12" Foreground="#424242" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="✕" Click="CloseFindPaneBtn_Click"
                                        Style="{StaticResource ToolBtn}" Background="#9E9E9E"
                                        Padding="6,2" FontSize="11"/>
                            </Grid>
                        </Border>
                        <!-- File name filter row -->
                        <Grid DockPanel.Dock="Top" Margin="8,6,8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center"
                                       FontSize="11" Foreground="#616161" Margin="0,0,6,0"/>
                            <TextBox x:Name="FindFileNameBox" Grid.Column="1" Padding="4,3" FontSize="11"
                                     BorderBrush="#BDBDBD"
                                     ToolTip="File name filter — e.g. 'vacation' finds files containing 'vacation'"
                                     KeyDown="FindPathsBox_KeyDown"/>
                        </Grid>
                        <!-- Path input row -->
                        <Grid DockPanel.Dock="Top" Margin="8,4,8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FindPathsBox" Grid.Column="0"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     Height="46" FontSize="11" Padding="6,4"
                                     ToolTip="One path per line: file or folder to search in (Ctrl+Enter to search)"
                                     KeyDown="FindPathsBox_KeyDown"/>
                            <Button Grid.Column="1" Content="📄 Files" Click="BrowseFilesBtn_Click"
                                    Style="{StaticResource ToolBtn}" Margin="4,0,0,0"
                                    VerticalAlignment="Stretch" FontSize="11"
                                    ToolTip="Browse and select files"/>
                            <Button Grid.Column="2" Content="📁 Folder" Click="BrowseFolderBtn_Click"
                                    Style="{StaticResource GreenBtn}" Margin="4,0,0,0"
                                    VerticalAlignment="Stretch" FontSize="11"
                                    ToolTip="Browse and select a folder"/>
                            <Button Grid.Column="3" Content="Search" Click="FindFilesBtn_Click"
                                    Style="{StaticResource ToolBtn}" Background="#455A64"
                                    Margin="4,0,0,0" VerticalAlignment="Stretch"/>
                        </Grid>
                        <TextBlock DockPanel.Dock="Top" Margin="8,0,8,4" FontSize="10" Foreground="#9E9E9E"
                                   Text="Name + path(s) to search. Ctrl+Enter to run. Results shown in File List."/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
